PORT=8080
BROKER_TYPE=META_API
# MetaTrader 5 via MetaAPI
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name

# Deriv API (Alternative switchable broker)
DERIV_TOKEN=your_deriv_token
DERIV_APP_ID=1089

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Risk Settings
ACCOUNT_RISK_PERCENT=1.0
PAIRS=EURUSD,GBPUSD,XAUUSD,GBPJPY
SIMULATION_MODE=true
